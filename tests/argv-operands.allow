# Every place a build hands a path to a compiler, linker or librarian, and
# every use of Exedir, with where its path comes from.  checked by
# tests/check-argv-operands.sh.
#
#   file|source line, as written, without its indent|why it is a path
#
# A path built from a value a folder or a project file sets (Exedir, the
# object and program names, FILES, LIBNAME) must come out of
# e_build_operand, which puts "./" in front of one that would start with
# '-' or '@' (an option, or a response file gcc, ar and ranlib read more
# options out of).  A new site fails the check until it is listed here,
# with the function that built its path.

# the link step of a single-file build: both from e_p_link_operands
we_prog.c|e_argc = e_add_arg(&e_arg, estr, 2, e_argc);|e_p_link_operands (e_build_operand)
we_prog.c|e_argc = e_add_arg(&e_arg, ostr, 3, e_argc);|e_p_link_operands (e_build_operand)
# the compile step of a single-file build
we_prog.c|argc = e_add_arg(&arg, fstr, argc, argc);|e_build_operand of the window's folder and name
we_prog.c|argc = e_add_arg(&arg, "-o", argc, argc);|a literal option
we_prog.c|argc = e_add_arg(&arg, ostr, argc, argc);|e_build_operand of Exedir and the name
# the project build
we_prog.c|e_argc = e_add_arg(&e_arg, e_s_prog.exe_name, 2, e_argc);|e_prj_program_path (e_build_operand)
we_prog.c|g_prj.argc = e_add_arg(&g_prj.arg, g_prj.df->name[k], g_prj.argc, g_prj.argc);|e_prj_files_as_paths (e_build_operand)
we_prog.c|g_prj.argc = e_add_arg(&g_prj.arg, "-o", g_prj.argc, g_prj.argc);|a literal option
we_prog.c|g_prj.argc = e_add_arg(&g_prj.arg, g_prj.ofile, g_prj.argc, g_prj.argc);|e_prj_object_name (e_build_operand)
we_prog.c|e_argc = e_add_arg(&e_arg, g_prj.ofile, e_argc, e_argc);|e_prj_object_name (e_build_operand)
we_prog.c|e_argc = e_add_arg(&e_arg, library, e_argc, e_argc);|LIBNAME through e_build_operand in e_prj_setup
we_prog.c|e_make_library(library, g_prj.ofile, e_prj_top(), e_prj_step_done, NULL);|LIBNAME and e_prj_object_name, both e_build_operand
# declarations and the definition, not uses
we_prog.c|int e_make_library(char *library, char *ofile, FENSTER *f,|the prototype
we_prog.c|int e_add_arg(char ***arg, char *str, int n, int argc)|the definition
# Exedir that reaches no build argv
we_prog.c|e_strlcat(estr, e_prog.exedir, sizeof(estr));|Run starts the program the build made, the folder's own code by design
we_prog.c|if (e_prog.exedir) FREE(e_prog.exedir);|the default being set
we_prog.c|e_prog.exedir = WpeStrdup(".");|the default being set
