#!/usr/bin/env python3
"""A gdb that holds back one command until it is told to go on.

It stands in front of the real gdb: every command the editor sends is passed
on, and gdb's output and error stream go straight to the editor, so what the
editor reads is what gdb writes.  One command, named by XWPE_STUB_STALL (a
prefix of the command line), is held instead.  gdb never sees it, so it
never answers, until one of two things happens:

  - the editor sends another command (after a cancel the editor makes gdb
    echo a marker): the held command goes to gdb first, then the new one, so
    gdb answers the old command late, exactly as a slow gdb would;
  - the test writes a line to the release pipe, $HOME/gdb-stub.release.

Nothing here waits on a clock: the held command waits on input only.  Only
the first command that matches is held, or the XWPE_STUB_STALL_NTH-th.

Every command is logged to $HOME/gdb-stub.log ("CMD <line>"), and the hold
as "STALL <line>" and "RELEASE <how>", so a test knows the editor is waiting
before it types.  SIGINT, which the editor sends to pause the program, is
passed to gdb.

XWPE_STUB_BUSY_EDITOR (a prefix of the command line) plays a loaded machine
for every command that starts with it: the editor is stopped (SIGSTOP)
before gdb is given the command and let go on (SIGCONT) once gdb's prompt
has been passed to it.  gdb writes a refusal on its error stream before it
writes that prompt, so when the editor runs again both are waiting for it
at once, which is what an editor busy drawing sees.  For this gdb's output
goes through the stub, so it can see the prompt; its error stream still
goes straight to the editor.  Logged as "BUSY <line>".

XWPE_STUB_FILL_ON_SIGNAL=1 plays a gdb that stops reading its input with
the pipe full: the stub writes its PID to $HOME/gdb-stub.pid, and on
SIGUSR1 it fills its own input pipe to the brim with NUL bytes (through
/proc/self/fd/0, Linux) and reads nothing more until the test writes to the
release pipe.  The editor's next command then finds the pipe full, as it
would behind a gdb stopped by the user.  After the release the NULs are
dropped as they are read (no command holds one), so every command behind
them reaches gdb as the editor sent it.  Logged as "FULL <bytes>" and
"RELEASE by the test"; the "CMD" lines follow.
"""
import os
import select
import shutil
import signal
import subprocess
import sys
import threading

HOME = os.environ.get("HOME", ".")
LOG = os.path.join(HOME, "gdb-stub.log")
RELEASE = os.path.join(HOME, "gdb-stub.release")
STALL = os.environ.get("XWPE_STUB_STALL", "")
STALL_NTH = int(os.environ.get("XWPE_STUB_STALL_NTH", "1") or "1")
BUSY = os.environ.get("XWPE_STUB_BUSY_EDITOR", "")
FILL = os.environ.get("XWPE_STUB_FILL_ON_SIGNAL", "") == "1"
PIDFILE = os.path.join(HOME, "gdb-stub.pid")
FILL_BYTE = b"\0"
FILL_CHUNK = 4096
OWN_INPUT = "/proc/self/fd/0"
GDB_PROMPT = b"(gdb) "
READ_MAX = 65536
HERE = os.path.dirname(os.path.abspath(__file__))


def note(text):
    with open(LOG, "a") as fh:
        fh.write(text + "\n")


def real_gdb():
    """The gdb this one stands in front of: the next one on PATH."""
    given = os.environ.get("XWPE_STUB_REAL_GDB", "")
    if given:
        return given
    dirs = [d for d in os.environ.get("PATH", "").split(os.pathsep)
            if d and os.path.abspath(d) != HERE]
    found = shutil.which("gdb", path=os.pathsep.join(dirs))
    if not found:
        sys.stderr.write("gdb stub: no real gdb on PATH\n")
        sys.exit(1)
    return found


def make_release_pipe():
    if os.path.exists(RELEASE):
        os.unlink(RELEASE)
    os.mkfifo(RELEASE)
    # Open for reading and writing, so the open never waits for a writer and
    # a writer that closes does not leave the pipe at end of file.
    return os.open(RELEASE, os.O_RDWR | os.O_NONBLOCK)


class Lines:
    """The editor's commands, a line at a time, read without a buffer that
    select() cannot see."""

    def __init__(self, fd):
        self.fd = fd
        self.buf = b""
        self.fill_left = 0

    def held(self):
        return b"\n" in self.buf

    def drop_fill(self, chunk):
        """The NULs the stub filled its pipe with are not the editor's."""
        if not self.fill_left:
            return chunk
        kept = chunk.replace(FILL_BYTE, b"")
        self.fill_left = max(0, self.fill_left - (len(chunk) - len(kept)))
        return kept

    def readline(self):
        while b"\n" not in self.buf:
            chunk = os.read(self.fd, 4096)
            if not chunk:
                rest, self.buf = self.buf, b""
                return rest
            self.buf += self.drop_fill(chunk)
        line, self.buf = self.buf.split(b"\n", 1)
        return line + b"\n"


def pass_on(child, line):
    child.stdin.write(line)
    child.stdin.flush()


def wait_for_go(child, held, release_fd, lines):
    """Hold @held until the editor sends more or the test releases it."""
    note("STALL " + held.decode("utf-8", "replace").rstrip("\n"))
    stdin_fd = lines.fd
    while True:
        if lines.held():
            ready = [stdin_fd]
        else:
            ready, _, _ = select.select([stdin_fd, release_fd], [], [])
        if release_fd in ready:
            os.read(release_fd, 4096)
            note("RELEASE by the test")
            pass_on(child, held)
            return None
        if stdin_fd in ready:
            nxt = lines.readline()
            note("RELEASE by the next command")
            pass_on(child, held)
            return nxt


def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def fill_own_input():
    """Fill the stub's input pipe until it takes no more byte.
    Return: the bytes written."""
    fd = os.open(OWN_INPUT, os.O_WRONLY | os.O_NONBLOCK)
    total = 0
    for size in (FILL_CHUNK, 1):
        try:
            while True:
                total += os.write(fd, FILL_BYTE * size)
        except BlockingIOError:
            pass
    os.close(fd)
    return total


class Hold(Exception):
    """SIGUSR1 came: the pipe is full, and the stub stops reading."""

    def __init__(self, filled):
        Exception.__init__(self)
        self.filled = filled


def on_fill_signal(signum, frame):
    raise Hold(fill_own_input())


def hold_until_release(filled, release_fd, lines):
    """Read nothing until the test lets the stub read again; then drop the
    @filled NULs as they come."""
    note("FULL %d" % filled)
    select.select([release_fd], [], [])
    os.read(release_fd, 4096)
    note("RELEASE by the test")
    lines.fill_left = filled


def note_pid():
    with open(PIDFILE, "w") as fh:
        fh.write(str(os.getpid()))


class BusyEditor:
    """Keeps the editor stopped while gdb answers one command, so gdb's
    error stream and its prompt wait for the editor together."""

    def __init__(self, child):
        self.child = child
        self.editor = os.getppid()
        self.lock = threading.Lock()
        self.stopped = False
        self.seen = b""

    def stop(self, line):
        note("BUSY " + line.decode("utf-8", "replace").rstrip("\n"))
        with self.lock:
            self.stopped = True
            self.seen = b""
        os.kill(self.editor, signal.SIGSTOP)

    def let_go(self):
        with self.lock:
            if not self.stopped:
                return
            self.stopped = False
        os.kill(self.editor, signal.SIGCONT)

    def passed(self, chunk):
        """@chunk of gdb's output has reached the editor: once it ends the
        answer with the prompt, the editor may run again."""
        with self.lock:
            if not self.stopped:
                return
            self.seen = (self.seen + chunk)[-len(GDB_PROMPT):]
            whole = self.seen.endswith(GDB_PROMPT)
        if whole:
            self.let_go()

    def relay(self):
        """Pass gdb's output on to the editor as it comes."""
        out = self.child.stdout.fileno()
        try:
            while True:
                chunk = os.read(out, READ_MAX)
                if not chunk:
                    break
                write_all(sys.stdout.fileno(), chunk)
                self.passed(chunk)
        finally:
            self.let_go()


def start_gdb():
    """The real gdb, its output relayed when the editor is to be kept busy."""
    argv = [real_gdb()] + sys.argv[1:]
    if not BUSY:
        return subprocess.Popen(argv, stdin=subprocess.PIPE), None
    child = subprocess.Popen(argv, stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE)
    busy = BusyEditor(child)
    threading.Thread(target=busy.relay, daemon=True).start()
    return child, busy


def main():
    child, busy = start_gdb()
    signal.signal(signal.SIGINT,
                  lambda signum, frame: child.send_signal(signal.SIGINT))
    signal.signal(signal.SIGTERM,
                  lambda signum, frame: child.kill() or sys.exit(0))
    release_fd = make_release_pipe()
    lines = Lines(sys.stdin.fileno())
    if FILL:
        signal.signal(signal.SIGUSR1, on_fill_signal)
        note_pid()
    seen = 0
    pending = None
    while True:
        try:
            line = pending if pending is not None else lines.readline()
        except Hold as hold:
            hold_until_release(hold.filled, release_fd, lines)
            continue
        pending = None
        if not line:
            break
        text = line.decode("utf-8", "replace").rstrip("\n")
        note("CMD " + text)
        if STALL and text.startswith(STALL):
            seen += 1
            if seen == STALL_NTH:
                pending = wait_for_go(child, line, release_fd, lines)
                continue
        if busy and text.startswith(BUSY):
            busy.stop(line)
        pass_on(child, line)
    child.stdin.close()
    child.wait()
    if busy:
        busy.let_go()


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
