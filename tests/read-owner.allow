# The reads outside we_read.c that still open a name themselves.  Checked by
# tests/check-read-owner.sh.
#
#   file|r22x:function|count|pass|reason
#
# x is the clause letter (a fopen, b open, c a folder listing, d fdopen, e a
# library that opens a file, f getline, g a request with no bound, k an
# object's imported opener, z an open token that is not a call); for clause k
# the file is the object and the function the symbol.  "count" may only fall,
# and a line that matches nothing is stale.  "pass" is the pass that moves the
# site onto the owner and deletes the line (P2 the assistant's reads, P3a the
# plain callers, P3a2 the load of a regular file, P3b the load of a pipe, P3c
# Find in files); a pass ending in
# /cfg is a row only some configurations meet, so a build without it is not
# stale.  "keep" is a permanent row, and the reason says why the name is the
# editor's own and not one a user, a folder, a model or a server chose.

# Find in files (P3c)
we_fl_unix.c|r22a:WpeGrepFile|1|P3c|every entry of a folder

# not a name a user, a folder, a model or a server chose
we_debug.c|r22a:e_d_compile_show_errors|1|keep|a file the editor wrote in its own 0700 temporary folder
we_debug.c|r22a:e_d_debugger_pid_read|1|keep|a file the editor wrote in its own 0700 temporary folder
we_debug.c|r22b:e_d_script_connect|4|keep|the debugger's own pipes and terminal, in the editor's 0700 temporary folder
we_debug.c|r22c:e_find_supported_jdk|1|keep|lists fixed system folders for a JDK and opens no file
we_debug.o|r22k:glob|1|keep|e_find_supported_jdk
we_fl_fkt.c|r22c:e_tmp_remove|1|keep|removes the editor's own temporary folder without following links
we_fl_fkt.o|r22k:nftw|1|keep|e_tmp_remove
we_opt.c|r22f:e_opt_read_line|1|keep|its stream is the owner's memory stream of at most 1 MiB
we_fileop.c|r22g:fileop_source_ask|2|keep|the copy reads its source to the end with constant memory, below the folder the walk holds, and a file ends
we_edit.c|r22g:e_edit_open|1|keep|File > Open and the command line: the user asked for that file, so its size is not limited
we_fl_fkt.c|r22g:e_i_open_judged|1|keep|a help or info file is read a node at a time from its descriptor (libc.info is over 10 MB), in the build with zlib and in the one without
we_fl_unix.c|r22g:fm_open_block_source|1|keep|Block > Read: the user asked for that file, so its size is not limited
we_prog.c|r22g:e_algol68_sniff|1|keep|reads the first 200 lines with constant memory, and a regular file ends
we_prog.c|r22g:e_check_header|1|keep|reads 120 bytes at a time with constant memory and a regular file ends; a bound in memory would remove the only brake the include recursion has
we_progn.c|r22g:e_aopen_stream|1|keep|reads a line at a time with constant memory and a regular file ends
we_startplan.c|r22g:startplan_is_build_output|1|keep|reads the first bytes of a build product from the descriptor, and no link is followed
we_startplan.c|r22g:wpe_startplan_elf_section|1|keep|reads fixed-size headers and sized sections of a program from the descriptor
we_write.c|r22b:write_backup_source|1|keep|the write owner's own judged open of the file it backs up
we_write.c|r22b:write_mode_open_descriptor|1|keep|the write owner's own judged open for the mode

# an identifier called open, not the function (a pair that nests, a record's
# offset): the scan cannot tell a variable from a function pointer
we_ai_ui.c|r22z:ai_find_closing_fence|3|keep|a variable called open
we_ai_ui.c|r22z:ai_reply_split|6|keep|a variable called open
we_ai_ui.c|r22z:wpe_ai_pane_save|1|keep|a variable called open
we_debsess.c|r22z:e_ds_jdb_frame_parse|8|keep|a variable called open
we_debsess.c|r22z:e_ds_pdb_frame_parse|8|keep|a variable called open
we_debsess.c|r22z:e_ds_pdb_stop_at_number|4|keep|a variable called open
we_debsess.c|r22z:e_ds_pdb_stop_parse|6|keep|a variable called open
we_debug.c|r22z:e_d_gj_answer_in_string|4|keep|a variable called open
we_debug.c|r22z:e_d_gj_string_open_after|2|keep|a variable called open
we_debug.c|r22z:e_d_jdb_prompt_len|6|keep|a variable called open
we_gdbmi.c|r22z:e_gdbmi_line_is_async|4|keep|a variable called open
we_gdbmi.c|r22z:e_gdbmi_line_is_result_of|4|keep|a variable called open
we_gdbmi.c|r22z:e_gdbmi_line_token|3|keep|a variable called open
we_layout.h|r22z:wpe_box_place|1|keep|a member called open
we_prog.c|r22z:e_prj_show_open|5|keep|a variable called open
we_shtok.c|r22z:-|1|keep|a member called open
we_write.c|r22z:write_aim_make|2|keep|a variable called open
we_write.c|r22z:write_keeps_file_ending|1|keep|a variable called open
