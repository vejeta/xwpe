# Offenders of tests/check-one-owner.sh that still stand.
#
#   object symbol count pass [reason]
#
# "count" is the number of places the source uses the name; it may only
# fall (the script fails when it is wrong in either direction, and when a
# line matches nothing any more).  "pass" is the pass that removes the
# line.  "keep" is a permanent exception and stays in --strict mode too.
# Each pass deletes the lines it clears; the last pass deletes the file.

# the assistant's commands whose callers need the answer before they return
# (the edit hook, the checkpoint, the changeset review inside its own key
# loop): one bounded wait on the command's output and the owner's wake pipe.
# A tool step's command runs on the loop.
we_ai.o poll 1 P9s2 the bounded wait of the hook, checkpoint and review commands

# the debugger
we_debug.o usleep 1 P9o the external xterm settle
we_debug.o STDIN_FILENO 1 keep ttyname_r names the editor's own terminal; no read

# the display's connection: only the X11 backend names it.  Wayland shares
# three schirm-only functions of that file, none of which touches Xlib.
we_wayland.o e_x_ 6 keep the extern and the three fills of the schirm-only functions
we_wayland.o e_x_sys_end 1 keep a schirm-only function shared with the X11 backend; no Xlib behind it
we_wayland.o e_x_sys_ini 1 keep a schirm-only function shared with the X11 backend; no Xlib behind it
we_wayland.o e_x_system 1 keep a schirm-only function shared with the X11 backend; no Xlib behind it

# the editor's end: after the save it runs the loop, bounded, until a
# closing debug adapter has ended its program; a signal, an error box or a
# closed window ends the editor from inside any dialog, so the end cannot
# return to the main loop
we_unix.o wpe_fd_end_wait 1 keep e_exit_teardown, the one nested wait

# a command that has the editor's terminal or window until it ends: the
# user waits for it, as a shell run from a terminal is waited for, while
# the loop serves the rest (the window repaints, the build reads on).
# e_shell_wait is the one wait; e_shell_run its one entry, counted with
# its definition: e_system (a script run with Ctrl-F9 on the console, then
# "Hit CR") and e_install_run (a project's install commands) in we_prog.c;
# e_x_system (a script run in an external xterm, File > Shell and the file
# manager's Execute under X11 and Wayland) in we_xterm.c; e_t_system
# (File > Shell and the file manager's Execute on the console) in we_term.c
we_prog.o wpe_fd_wait_serving 1 keep e_shell_wait, the wait of a command that has the terminal or window
we_child.o wpe_fd_wait_serving 1 keep wpe_capture_serve_until, a short command whose answer the editor needs, always within its deadline
we_prog.o e_shell_run 3 keep the definition, e_system and e_install_run
we_xterm.o e_shell_run 1 keep e_x_system
we_term.o e_shell_run 1 keep e_t_system

# keys: the names a platform gives its keys are spelled by the key table
# (we_keymap.c) and nowhere else in the display code.  What is left is text,
# not keys.
we_xterm.o XK_ 65 keep the dead-key compose table and the Alt-letter recovery of XQuartz's Compose mode: text, not keys
we_wayland.o XKB_KEY_ 38 keep the built-in keysym selftest's table of keys to feed keysym_to_xwpe

# console mouse, clipboard, display
we_gpm.o poll 1 P9o the gpm handshake
we_gpm.o STDIN_FILENO 2 keep isatty asks whether the terminal is the console; no read
we_wayland.o poll 1 P9o the clipboard pipe
we_xterm.o poll 1 P9o the paste wait for SelectionNotify

# children: started, signalled and reaped only by we_child.c.
we_unix.o waitpid 1 keep the SIGCHLD handler reaps, and hands each child to we_child.c

# children the user's keys start come from a start plan (we_startplan.c),
# the only importer of wpe_child_start for them: the build, Run, Make, the
# shell entries, the install lines, the language and build servers, the
# debug session's starts and the short commands (through
# wpe_startplan_capture and its kin).  we_child.c refuses a start with no
# plan; the assistant's children are the only others, marked AI origin.
we_ai.o wpe_child_start 2 P1 the assistant's tool command and CLI: AI origin, held by the containment profile
we_ai_host.o wpe_child_start 1 P1 the hosted engine: AI origin, held by the containment profile

# the screen: every box, menu, prefix and dialog reads its keys through the
# owner's bracket.  The main loop's read and the owner's key hook stay in
# we_edit.c; the check allows no other line for the screen's names.
we_edit.o e_getch 2 keep the main loop's read and the owner's key hook (e_paint_read_key)

# the test's state channel: only with XWPE_TEST_DUMP_FD set, the display's
# key reader and its look at the keyboard are wrapped so the editor writes
# its state to the test's pipe before it waits for a key.
we_testdump.o e_u_key_take 3 keep the wrapper of the look at the keyboard, installed for a test only
we_testdump.o STDIN_FILENO 1 keep FIONREAD asks whether a key is pending; no read
we_testdump.o write 1 keep the test's dump pipe, not a child

# writers: bytes for a child go through wpe_fd_write (we_fdloop.c).
we_ai.o write 1 keep the test backend's temporary file, not a child
we_ai_http.o write 1 keep a server's socket, not a child: written from the loop's wake-ups, a TLS write retried with the same buffer
we_wayland.o write 1 P9o the clipboard pipe
we_ai.o fdopen 1 keep the API key file, not a child
we_startcmd.o fdopen 1 keep the remembered answers' store, a regular file checked on its descriptor, not a child
we_ai_ws.o write 1 keep a regular file the model named, opened at the place the scope judged (wpe_path_open_write): no child, no pipe

# the text: every line a window adds or removes goes through its owner
# (we_buffer.c), and the check allows no line for its names.

# the positions: the cursor, the block, the find mark, the anchor and the
# markers are written only through the owner's calls (we_buffer.c).  These
# are the writes still made in place, counted per object and rule; the
# count may only fall, and the pass that converts the last of them deletes
# the lines and makes the section strict.
we_ai_ui.o pos_field 17 P11k-B
we_ai_ui.o pos_whole 2 P11k-B
we_ai_ws.o pos_field 1 P11k-B
we_debug.o pos_field 16 P11k-B
we_fl_fkt.o pos_field 14 P11k-B
we_fl_unix.o pos_field 2 P11k-B
we_fl_unix.o pos_whole 2 P11k-B
we_progn.o pos_field 15 P11k-B
we_progn.o pos_whole 6 P11k-B
we_prog.o pos_field 23 P11k-B
we_unix.o pos_field 2 P11k-B
