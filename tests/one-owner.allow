# Offenders of tests/check-one-owner.sh that still stand.
#
#   object symbol count pass [reason]
#
# "count" is the number of places the source uses the name; it may only
# fall (the script fails when it is wrong in either direction, and when a
# line matches nothing any more).  "pass" is the pass that removes the
# line.  "keep" is a permanent exception and stays in --strict mode too.
# Each pass deletes the lines it clears; the last pass deletes the file.

# the assistant's waits for a model's reply
we_ai_http.o poll 1 P9l
we_ai.o poll 3 P9l
we_ai.o usleep 1 P9l the mock backend's delay, to become a loop timer
we_ai.o STDIN_FILENO 2 P9l watches fd 0 for Esc during the modal wait
we_ai_ui.o STDIN_FILENO 1 P9l the model listing watches fd 0 for Esc
we_ai_ui.o e_u_kbhit 1 P9l the model listing reads Esc through the display table

# the build server and the language server
we_bsp.o poll 2 P9k
we_lsp.o poll 2 P9k the handshake and the message reads
we_lsp.o nanosleep 1 P9i server end moves to the child watch

# the debugger
we_debug.o usleep 1 P9o the external xterm settle
we_debug.o XFlush 2 P9o the focus taken back after the start and the external xterm settle; no read
we_debug.o STDIN_FILENO 1 keep ttyname_r names the editor's own terminal; no read

# the editor's end: after the save it runs the loop, bounded, until a
# closing debug adapter has ended its program; a signal, an error box or a
# closed window ends the editor from inside any dialog, so the end cannot
# return to the main loop
we_unix.o wpe_fd_end_wait 1 keep e_exit_teardown, the one nested wait

# console mouse, clipboard, display
we_gpm.o poll 1 P9o the gpm handshake
we_gpm.o STDIN_FILENO 2 keep isatty asks whether the terminal is the console; no read
we_wayland.o poll 1 P9o the clipboard pipe
we_xterm.o poll 1 P9o the paste wait for SelectionNotify

# children: started, signalled and reaped only by we_child.c.  P9i2 is the
# second half of P9i (the language server, the build server, the adapters).
we_unix.o waitpid 1 keep the SIGCHLD handler reaps, and hands each child to we_child.c
we_unix.o kill 2 P9q the crash/term handlers' build group and the debugger at exit
we_prog.o fork 1 P9r Run with a pty (the build moved to we_child.c)
we_prog.o openpty 1 P9r
we_prog.o killpg 1 P9r
we_prog.o setsid 1 P9r
we_prog.o waitpid 1 P9r
we_prog.o execl 1 P9r through wpe_system, inline
we_prog.o popen 1 P9n
we_prog.o pclose 1 P9n
we_xterm.o fork 1 P9r through wpe_system, inline
we_xterm.o waitpid 1 P9r
we_xterm.o execl 1 P9r
we_term.o system 1 P9r the display table's run of a shell command
we_dap.o fork 2 P9i2
we_dap.o openpty 1 P9i2
we_dap.o kill 1 P9i2
we_dap.o waitpid 1 P9i2
we_dap.o setsid 2 P9i2
we_dap.o execvp 2 P9i2
we_lsp.o fork 1 P9i2
we_lsp.o kill 2 P9i2
we_lsp.o waitpid 3 P9i2
we_lsp.o setsid 1 P9i2 through wpe_child_apart_from_terminal, inline
we_lsp.o execvp 1 P9i2
we_bsp.o fork 1 P9i2
we_bsp.o kill 2 P9i2
we_bsp.o waitpid 2 P9i2
we_bsp.o setsid 1 P9i2 through wpe_child_apart_from_terminal, inline
we_bsp.o execvp 1 P9i2
we_bsp.o system 1 P9i2 scala-cli setup-ide, to become an async start
we_bsp.o SYS_pidfd_open 2 P9i2 the launcher's exit descriptor, deleted with the ladder
we_debug.o fork 2 P9q
we_debug.o openpty 1 P9q
we_debug.o kill 6 P9q
we_debug.o waitpid 4 P9q
we_debug.o setsid 2 P9q
we_debug.o execvp 2 P9q
we_debug.o execl 1 P9q the legacy external-xterm start
we_debug.o execlp 1 P9q the same
we_debug.o system 2 P9q compile for debug (P9q) and scala-cli setup-ide (P9i2)
we_debug.o popen 1 P9n
we_debug.o pclose 1 P9n
we_ai.o fork 3 P9s one is the mock delay (P9l)
we_ai.o kill 2 P9s
we_ai.o waitpid 2 P9s
we_ai.o setsid 1 P9s
we_ai.o execv 1 P9s
we_ai.o execvp 1 P9s
we_ai_host.o fork 1 P9s
we_ai_host.o kill 3 P9s
we_ai_host.o waitpid 3 P9s
we_ai_host.o execvp 2 P9s
we_render_cairo.o popen 1 P9n
we_render_cairo.o pclose 2 P9n
we_fl_fkt.o system 2 P9n
we_fl_unix.o system 2 P9n
